{
    "version": 2,
    "builds": [
        {
            "src": "index.html",
            "use": "@vercel/static"
        },
        {
            "src": "login.html",
            "use": "@vercel/static"
        },
        {
            "src": "api/login.py",
            "use": "@vercel/python"
        },
        {
            "src": "api/callback.py",
            "use": "@vercel/python"
        },
        {
            "src": "api/me.py",
            "use": "@vercel/python"
        },
        {
            "src": "api/logout.py",
            "use": "@vercel/python"
        },
        {
            "src": "api/turn.py",
            "use": "@vercel/python",
            "config": {
                "includeFiles": [
                    "refactored-agents/guardian-agent/**",
                    "refactored-agents/lab-companion-agent/**",
                    "refactored-agents/participant-agent/**",
                    "api/requirements.txt"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/login",
            "dest": "/login.html"
        },
        {
            "src": "/api/login",
            "dest": "/api/login.py"
        },
        {
            "src": "/api/callback",
            "dest": "/api/callback.py"
        },
        {
            "src": "/api/me",
            "dest": "/api/me.py"
        },
        {
            "src": "/api/logout",
            "dest": "/api/logout.py"
        },
        {
            "src": "/api/turn",
            "dest": "/api/turn.py"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}
